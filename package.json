{
  "name": "jianji-cv-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run db:migrate:local",
    "db:migrate:local": "node scripts/prepare-local-d1.mjs",
    "db:verify": "node scripts/verify-legacy-schema-adoption.mjs && vitest run tests/database-migrations.test.ts",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --var APP_ENV:development",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runner": "node --test services/codex-runner/test/*.test.mjs",
    "test:agent-ui": "node scripts/verify-agent-workspace.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && node scripts/verify-production-artifact.mjs",
    "verify:release": "npm run db:migrate:local && npm run db:verify && npm run verify"
  },
  "dependencies": {
    "better-auth": "1.7.2",
    "docx": "9.7.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "html-to-image": "1.11.13",
    "lucide-react": "^0.468.0",
    "mammoth": "1.12.2",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260830.1",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.127.1"
  }
}
