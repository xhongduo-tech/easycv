# Canonical URL used by Open Graph and social sharing metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Runtime mode is mandatory in production. Local OTP/email capture must remain
# explicitly enabled only for loopback development.
APP_ENV=development
AUTH_DEV_CAPTURE=true
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
# Optional non-destructive rotation, newest version first: 2:<secret>,1:<secret>
BETTER_AUTH_SECRETS=
BETTER_AUTH_TRUSTED_ORIGINS=
AUTH_ADMIN_EMAILS=
RESEND_API_KEY=
AUTH_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou

# Optional server-side DeepSeek Responses API integration. All three values are
# required before the editor offers an explicit opt-in to the large model.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Text-only resume optimization defaults to the lower-cost V4 Flash model.
DEEPSEEK_MODEL=deepseek-v4-flash
# Peak-price estimated daily model spend guard. Credits and abuse rate limits are separate.
DEEPSEEK_DAILY_BUDGET_CNY=200

# Codex Agent task core. Run services/codex-runner separately on Linux; Workers
# cannot run the Codex CLI. Disabled until an authenticated runner is online.
# Preview is sponsored: these are USD microdollars, never user credit points.
CODEX_AGENT_ENABLED=false
CODEX_RUNNER_SECRET=
CODEX_MODEL=
# Explicit reviewed caps required (1 USD = 1000000 micros). No implicit budget.
CODEX_JOB_BUDGET_MICROS=
CODEX_DAILY_BUDGET_MICROS=
CODEX_MAX_JOBS_PER_DAY=3
CODEX_MAX_MODEL_CALLS=6
CODEX_MAX_OUTPUT_TOKENS=4000
# OPENAI_API_KEY belongs ONLY in the independent runner's secret environment.

# Stable 32+ character HMAC secret for one-time signup promotions. Do not
# rotate it without migrating existing redemption hashes.
PROMO_REDEMPTION_PEPPER=local-promo-hmac-key-2026-do-not-use-in-production
# Optional bearer secret for an external retention-maintenance scheduler.
MAINTENANCE_SECRET=
